# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
/build/
/dist/

# Environments
.venv/
.conda/
/env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Run logs
*.log

# Model checkpoints / large artifacts (keep the folder)
checkpoints/*
!checkpoints/.gitkeep

# Downloaded corpora / model artifacts — repo root only (anchor with a leading
# slash so this does NOT match source packages like src/onebit_asr/data/).
/data/
*.safetensors
*.bin
*.pt
*.pth
*.onnx

# Temporary / local scratch
*.tmp

# Kaggle execution (generated locally by scripts/kaggle_*.ps1)
/kaggle/build/
/kaggle/output/
# Effective config generated inside the Kaggle clone by kaggle/kernel.py
configs/kaggle_effective_attn.yaml
