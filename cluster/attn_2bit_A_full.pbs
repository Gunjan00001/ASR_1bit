#!/bin/bash
#PBS -N attn_2bit_A_full
#PBS -q gpu
#PBS -l select=1:ncpus=1:ngpus=1:mem=64gb
#PBS -l walltime=04:00:00
#PBS -j oe
set -uo pipefail
REPO="/home/jiit_992401210050/Desktop/ASR WaveTransformer/ASR_1bit"
cd "$REPO" || exit 1
source cluster/pick_gpu.sh
export ONEBIT_AUDIO_DECODER=soundfile PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false
export HF_HUB_DISABLE_PROGRESS_BARS=1 HF_DATASETS_DISABLE_PROGRESS_BARS=1
LOG="logs/attn_2bit_A_full.log"; mkdir -p logs results checkpoints; : > "$LOG"
exec > >(tee -a "$LOG") 2>&1
echo "=== job $PBS_JOBID $(hostname) $(date -Is) ==="; git rev-parse HEAD
nvidia-smi --query-gpu=index,name,memory.used,memory.total --format=csv,noheader
PY=".venv/bin/python"
$PY - <<'PY'
import torch
assert torch.cuda.is_available()
print("torch", torch.__version__, "cuda", torch.version.cuda, torch.cuda.get_device_name(0))
PY
[ $? -eq 0 ] || { echo "ABORT CUDA"; exit 3; }
CFG="configs/cluster_effective_attn_2bit_on_2bitffn_A_full.yaml"
cat > "$CFG" <<'YAML'
# GENERATED by cluster/attn_2bit_A_full.pbs — do not edit or commit.
extends: attn_2bit_on_2bitffn_A.yaml
qat:
  training:
    fp16: true
    bf16: false
    gradient_checkpointing: false
    save_strategy: "steps"
    save_steps: 250
    save_total_limit: 1
    logging_steps: 10
    eval_every_steps: 500
    eval_utterances: 256
YAML
cat "$CFG"
RESULT="results/attn_2bit_on_2bitffn_A_full.json"; CKPT="checkpoints/attn_2bit_on_2bitffn_A_full"
PACKED="checkpoints/attn_2bit_on_2bitffn_A_full_packed/model_packed.safetensors"
SIZE="results/attn_2bit_on_2bitffn_A_full_size_report.json"; VERIFY="results/packed_verify_attn_2bit_on_2bitffn_A_full.json"
if [ -s "$RESULT" ]; then echo "result exists"; else
  RESUME=""; [ -d "$CKPT" ] && compgen -G "$CKPT/checkpoint-*" >/dev/null && RESUME="--resume auto"
  $PY scripts/train_qat.py --config "$CFG" --output "$RESULT" --checkpoint-dir "$CKPT" $RESUME
  echo "train exit: $?"
fi
[ -s "$RESULT" ] || { echo "ABORT no result"; exit 4; }
if [ ! -s "$PACKED" ] || [ ! -s "$SIZE" ]; then
  $PY scripts/pack_qat_model.py --config "$CFG" --checkpoint "$CKPT" --output "$PACKED" --report "$SIZE"; echo "pack exit: $?"
fi
if [ ! -s "$VERIFY" ]; then
  ONEBIT_AUDIO_DECODER=soundfile $PY scripts/verify_packed_artifact.py --config "$CFG" --checkpoint "$CKPT" --artifact "$PACKED" --n 2 --output "$VERIFY"; echo "verify exit: $?"
fi
echo "=== finished $(date -Is) ==="
