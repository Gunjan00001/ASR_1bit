#!/bin/bash
#PBS -N distill_attn_ffn
#PBS -q gpu
#PBS -l select=1:ncpus=1:ngpus=1:mem=64gb
#PBS -l walltime=06:00:00
#PBS -j oe
#
# Phase 13 — knowledge distillation: frozen FP32 teacher -> attention+FFN
# 1-bit student (the QAT configuration that collapsed under PTQ).
#
# Teacher logits are precomputed once and cached under checkpoints/ (git-ignored),
# so all 3 epochs reuse the same teacher pass.
#
# 1 CPU: the cluster's per-user CPU quota is the bottleneck, not the GPUs. The
# job is GPU-bound (teacher precompute + training), so a single CPU is enough
# and lets this run alongside the other QAT jobs instead of waiting.

set -uo pipefail

REPO="/home/jiit_992401210050/Desktop/ASR WaveTransformer/ASR_1bit"
cd "$REPO" || exit 1

# shellcheck disable=SC1091
source cluster/pick_gpu.sh
export ONEBIT_AUDIO_DECODER=soundfile
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HUB_DISABLE_PROGRESS_BARS=1
export HF_DATASETS_DISABLE_PROGRESS_BARS=1

LOG="logs/distill_attn_ffn.log"
mkdir -p logs results checkpoints
: > "$LOG"
exec > >(tee -a "$LOG") 2>&1

echo "=== job $PBS_JOBID on $(hostname) at $(date -Is) ==="
nvidia-smi --query-gpu=index,name,memory.used,memory.total,utilization.gpu \
    --format=csv,noheader

PY=".venv/bin/python"
$PY - <<'PY'
import torch
assert torch.cuda.is_available(), "CUDA not available"
print("torch", torch.__version__, "cuda", torch.version.cuda,
      "device", torch.cuda.get_device_name(0),
      "count", torch.cuda.device_count())
PY
if [ $? -ne 0 ]; then echo "ABORT: CUDA preflight failed"; exit 3; fi

EFFECTIVE="configs/cluster_effective_distill_attn_ffn.yaml"
cat > "$EFFECTIVE" <<'YAML'
# GENERATED by cluster/distill_attn_ffn.pbs — do not edit or commit.
extends: distill_attn_ffn.yaml
qat:
  training:
    fp16: true
    bf16: false
    gradient_checkpointing: false
    save_strategy: "no"
    logging_steps: 10
YAML
echo "effective config:"; cat "$EFFECTIVE"

$PY scripts/train_distillation.py \
    --config "$EFFECTIVE" \
    --output results/distill_attn_ffn.json \
    --checkpoint-dir checkpoints/distill_attn_ffn
TRAIN_RC=$?
echo "train_distillation.py exit code: $TRAIN_RC"
[ -s results/distill_attn_ffn.json ] || { echo "ABORT: no result"; exit 4; }

$PY scripts/pack_qat_model.py \
    --config "$EFFECTIVE" \
    --checkpoint checkpoints/distill_attn_ffn \
    --output checkpoints/distill_attn_ffn_packed/model_packed.safetensors \
    --report results/distill_attn_ffn_size_report.json
echo "pack exit code: $?"
echo "=== finished at $(date -Is) ==="
