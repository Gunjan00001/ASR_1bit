#!/bin/bash
#PBS -N distill_attn_ffn_kd01
#PBS -q gpu
#PBS -l select=1:ncpus=1:ngpus=1:mem=64gb
#PBS -l walltime=04:00:00
#PBS -j oe
#
# Phase 13/14 follow-up — distillation with lambda_kd=0.1 (vs 0.5).
#
# Reuses the precomputed teacher-logits cache from the first distillation run
# (same teacher/split/subset/seed), so this is ~1.1 h rather than ~1.9 h.
# Everything else is identical to cluster/distill_attn_ffn.pbs.

set -uo pipefail

REPO="/home/jiit_992401210050/Desktop/ASR WaveTransformer/ASR_1bit"
cd "$REPO" || exit 1

# shellcheck disable=SC1091
source cluster/pick_gpu.sh
export ONEBIT_AUDIO_DECODER=soundfile
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HUB_DISABLE_PROGRESS_BARS=1
export HF_DATASETS_DISABLE_PROGRESS_BARS=1

LOG="logs/distill_attn_ffn_kd01.log"
mkdir -p logs results checkpoints
: > "$LOG"
exec > >(tee -a "$LOG") 2>&1

echo "=== job $PBS_JOBID on $(hostname) at $(date -Is) ==="
nvidia-smi --query-gpu=index,name,memory.used,memory.total,utilization.gpu \
    --format=csv,noheader

PY=".venv/bin/python"
$PY - <<'PY'
import torch
assert torch.cuda.is_available(), "CUDA not available"
print("torch", torch.__version__, "cuda", torch.version.cuda,
      "device", torch.cuda.get_device_name(0), "count", torch.cuda.device_count())
PY
if [ $? -ne 0 ]; then echo "ABORT: CUDA preflight failed"; exit 3; fi

EFFECTIVE="configs/cluster_effective_distill_attn_ffn_kd01.yaml"
cat > "$EFFECTIVE" <<'YAML'
# GENERATED by cluster/distill_attn_ffn_kd01.pbs — do not edit or commit.
extends: distill_attn_ffn_kd01.yaml
qat:
  training:
    fp16: true
    bf16: false
    gradient_checkpointing: false
    save_strategy: "no"
    logging_steps: 10
YAML
echo "effective config:"; cat "$EFFECTIVE"

$PY scripts/train_distillation.py \
    --config "$EFFECTIVE" \
    --output results/distill_attn_ffn_kd01.json \
    --checkpoint-dir checkpoints/distill_attn_ffn_kd01
TRAIN_RC=$?
echo "train_distillation.py exit code: $TRAIN_RC"
[ -s results/distill_attn_ffn_kd01.json ] || { echo "ABORT: no result"; exit 4; }

$PY scripts/pack_qat_model.py \
    --config "$EFFECTIVE" \
    --checkpoint checkpoints/distill_attn_ffn_kd01 \
    --output checkpoints/distill_attn_ffn_kd01_packed/model_packed.safetensors \
    --report results/distill_attn_ffn_kd01_size_report.json
echo "pack exit code: $?"
echo "=== finished at $(date -Is) ==="
