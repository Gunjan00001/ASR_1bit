#!/bin/bash
#PBS -N eval_short_oversample
#PBS -q gpu
#PBS -l select=1:ncpus=1:ngpus=1:mem=64gb
#PBS -l walltime=00:30:00
#PBS -j oe

set -uo pipefail
REPO="/home/jiit_992401210050/Desktop/ASR WaveTransformer/ASR_1bit"
cd "$REPO" || exit 1
source cluster/pick_gpu.sh
export ONEBIT_AUDIO_DECODER=soundfile
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HUB_DISABLE_PROGRESS_BARS=1
export HF_DATASETS_DISABLE_PROGRESS_BARS=1

OUT="results/short_oversample_pilot_dev256"
LOG="logs/eval_short_oversample_dev256.log"
mkdir -p logs "$OUT"
: > "$LOG"
exec > >(tee -a "$LOG") 2>&1

echo "=== job $PBS_JOBID on $(hostname) at $(date -Is) ==="
git rev-parse HEAD
nvidia-smi --query-gpu=index,name,memory.used,memory.total --format=csv,noheader

if [ -e "$OUT/final_comparison_dev_n256.json" ]; then
  echo "ABORT: output already exists: $OUT"
  exit 5
fi

.venv/bin/python scripts/run_final_eval.py \
  --split dev --n 256 --seed 42 \
  --arms attn_2bit_A_short_oversample_pilot \
  --no-benchmark --no-progress \
  --output-dir "$OUT"
echo "eval exit: $?"
echo "=== finished at $(date -Is) ==="
