#!/bin/bash
#PBS -N final_eval_full
#PBS -q gpu
#PBS -l select=1:ncpus=1:ngpus=1:mem=64gb
#PBS -l walltime=01:00:00
#PBS -j oe
#
# Final evaluation of the two full-run finalists on the predefined test sets.
# Accuracy-only for full test-clean; test-256 includes the warmed-up benchmark.
# Outputs go to NEW directories so historical comparison tables are untouched.
#
# The selected checkpoints are the best-dev states restored by DevWERCallback
# (both selected step 1,875).

set -uo pipefail
REPO="/home/jiit_992401210050/Desktop/ASR WaveTransformer/ASR_1bit"
cd "$REPO" || exit 1
# shellcheck disable=SC1091
source cluster/pick_gpu.sh
export ONEBIT_AUDIO_DECODER=soundfile
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HUB_DISABLE_PROGRESS_BARS=1
export HF_DATASETS_DISABLE_PROGRESS_BARS=1

LOG="logs/final_eval_full.log"
mkdir -p logs results/full_arms_test_n256 results/full_arms_test_n2620
: > "$LOG"
exec > >(tee -a "$LOG") 2>&1

echo "=== job $PBS_JOBID on $(hostname) at $(date -Is) ==="
echo "commit: $(git rev-parse HEAD)"
nvidia-smi --query-gpu=index,name,memory.used,memory.total --format=csv,noheader

PY=".venv/bin/python"
ARMS="qat_ffn_control_full,qat_ffn_mixed_full"

echo "=== TEST-256 with benchmark ==="
$PY scripts/run_final_eval.py \
    --split test --n 256 --arms "$ARMS" \
    --output-dir results/full_arms_test_n256 --no-progress
echo "test-256 exit: $?"

echo "=== FULL TEST-CLEAN 2620 (accuracy-only) ==="
$PY scripts/run_final_eval.py \
    --split test --n 2620 --arms "$ARMS" \
    --output-dir results/full_arms_test_n2620 --no-progress --no-benchmark
echo "full-test exit: $?"

echo "=== finished at $(date -Is) ==="
