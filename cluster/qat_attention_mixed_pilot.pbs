#!/bin/bash
#PBS -N qat_attn_mixed_pilot
#PBS -q gpu
#PBS -l select=1:ncpus=1:ngpus=1:mem=64gb
#PBS -l walltime=02:00:00
#PBS -j oe
#
# Comparative pilot for one attention-precision policy on top of the mixed FFN.
# The 17 FFN exclusions are inherited unchanged from qat_ffn_mixed.yaml.
#
# The default policy is the conservative category policy (attention_output);
# the sensitive-24 config can be selected with CONFIG=... .
#
# Comparable to the existing mixed FFN pilot: 2,000 train.100 utterances,
# 500 steps, seed 42, batch 4 x accum 4, dev-128, best-dev selection.
# Do not submit unless the screen supports the policy and a 1-CPU/1-GPU slot
# is available (scripts/check_cluster_resources.py reports ready).
#
# Output identifier: results/attention_v1_<policy>_pilot.json

set -uo pipefail
REPO="/home/jiit_992401210050/Desktop/ASR WaveTransformer/ASR_1bit"
cd "$REPO" || exit 1
# shellcheck disable=SC1091
source cluster/pick_gpu.sh
export ONEBIT_AUDIO_DECODER=soundfile
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HUB_DISABLE_PROGRESS_BARS=1
export HF_DATASETS_DISABLE_PROGRESS_BARS=1

CONFIG="${CONFIG:-configs/attention_v1_cpu16_category.yaml}"
POLICY_ID="${POLICY_ID:-attention_v1_cpu16_category}"
EFFECTIVE="configs/cluster_effective_${POLICY_ID}_pilot.yaml"
LOG="logs/${POLICY_ID}_pilot.log"
mkdir -p logs results checkpoints
: > "$LOG"
exec > >(tee -a "$LOG") 2>&1

echo "=== job $PBS_JOBID on $(hostname) at $(date -Is) ==="
echo "commit: $(git rev-parse HEAD)"
echo "base config: $CONFIG | policy id: $POLICY_ID"
nvidia-smi --query-gpu=index,name,memory.used,memory.total --format=csv,noheader

PY=".venv/bin/python"
$PY - <<'PY'
import torch
assert torch.cuda.is_available(), "CUDA not available"
print("torch", torch.__version__, "cuda", torch.version.cuda,
      "device", torch.cuda.get_device_name(0), "count", torch.cuda.device_count())
PY
if [ $? -ne 0 ]; then echo "ABORT: CUDA preflight failed"; exit 3; fi

cat > "$EFFECTIVE" <<YAML
# GENERATED by cluster/qat_attention_mixed_pilot.pbs — do not edit or commit.
extends: ${CONFIG}
qat:
  training:
    fp16: true
    bf16: false
    gradient_checkpointing: false
    save_strategy: "no"
    logging_steps: 10
YAML
echo "effective config:"; cat "$EFFECTIVE"

$PY scripts/train_qat.py \
    --config "$EFFECTIVE" \
    --pilot \
    --output "results/${POLICY_ID}_pilot.json" \
    --checkpoint-dir "checkpoints/${POLICY_ID}_pilot"
TRAIN_RC=$?
echo "train_qat exit: $TRAIN_RC"

if [ ! -s "results/${POLICY_ID}_pilot.json" ]; then
  echo "ABORT: no pilot result JSON; not packing"
  exit 4
fi

PACKED="checkpoints/${POLICY_ID}_pilot_packed/model_packed.safetensors"
SIZE_REPORT="results/${POLICY_ID}_pilot_size_report.json"
$PY scripts/pack_qat_model.py \
    --config "$EFFECTIVE" \
    --checkpoint "checkpoints/${POLICY_ID}_pilot" \
    --output "$PACKED" \
    --report "$SIZE_REPORT"
echo "pack exit: $?"

ONEBIT_AUDIO_DECODER=soundfile $PY scripts/verify_packed_artifact.py \
    --config "$EFFECTIVE" \
    --checkpoint "checkpoints/${POLICY_ID}_pilot" \
    --artifact "$PACKED" \
    --n 2 \
    --output "results/packed_verify_${POLICY_ID}_pilot.json"
echo "verify exit: $?"
echo "=== finished at $(date -Is) ==="
