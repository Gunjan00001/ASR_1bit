#!/bin/bash
#PBS -N qat_attn_a100
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=64gb
#PBS -l walltime=05:00:00
#PBS -j oe
#
# Phase 11/14 — attention-only 1-bit QAT re-run on an A100.
#
# The original attention-only result (results/qat_attn.json) was measured on a
# Kaggle T4 and its checkpoint is not in this repository. This run produces a
# like-for-like A100 checkpoint so the final comparison table (Phase 12/14) is
# measured on one machine with one precision. It does NOT overwrite the
# historical Kaggle result: outputs are named *_a100.
#
# 4 CPUs (not 8) because the cluster enforces a per-user 16-CPU quota and the
# attention+FFN job is already running.

set -uo pipefail

REPO="/home/jiit_992401210050/Desktop/ASR WaveTransformer/ASR_1bit"
cd "$REPO" || exit 1

# shellcheck disable=SC1091
source cluster/pick_gpu.sh
export ONEBIT_AUDIO_DECODER=soundfile
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HUB_DISABLE_PROGRESS_BARS=1
export HF_DATASETS_DISABLE_PROGRESS_BARS=1

LOG="logs/qat_attn_a100.log"
mkdir -p logs results checkpoints
: > "$LOG"
exec > >(tee -a "$LOG") 2>&1

echo "=== job $PBS_JOBID on $(hostname) at $(date -Is) ==="
nvidia-smi --query-gpu=index,name,memory.used,memory.total,utilization.gpu \
    --format=csv,noheader

PY=".venv/bin/python"
$PY - <<'PY'
import torch
assert torch.cuda.is_available(), "CUDA not available"
print("torch", torch.__version__, "cuda", torch.version.cuda,
      "device", torch.cuda.get_device_name(0),
      "count", torch.cuda.device_count())
PY
if [ $? -ne 0 ]; then echo "ABORT: CUDA preflight failed"; exit 3; fi

EFFECTIVE="configs/cluster_effective_attn_a100.yaml"
cat > "$EFFECTIVE" <<'YAML'
# GENERATED by cluster/qat_attn_a100.pbs — do not edit or commit.
extends: qat_attn.yaml
qat:
  training:
    fp16: true
    bf16: false
    gradient_checkpointing: false
    save_strategy: "no"
    logging_steps: 10
YAML
echo "effective config:"; cat "$EFFECTIVE"

$PY scripts/train_qat.py \
    --config "$EFFECTIVE" \
    --output results/qat_attn_a100.json \
    --checkpoint-dir checkpoints/qat_attn_a100
TRAIN_RC=$?
echo "train_qat.py exit code: $TRAIN_RC"
[ -s results/qat_attn_a100.json ] || { echo "ABORT: no result"; exit 4; }

$PY scripts/pack_qat_model.py \
    --config "$EFFECTIVE" \
    --checkpoint checkpoints/qat_attn_a100 \
    --output checkpoints/qat_attn_a100_packed/model_packed.safetensors \
    --report results/qat_attn_a100_size_report.json
echo "pack exit code: $?"
echo "=== finished at $(date -Is) ==="
