#!/bin/bash
#PBS -N qat_attn_ffn
#PBS -q gpu
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=06:00:00
#PBS -j oe
#
# Phase 11 — attention+FFN 1-bit QAT on an A100 (cloud-gpu profile).
#
# Unlike the Kaggle runner, this cluster gives us 80 GB per GPU, so no gradient
# checkpointing is needed. The pristine experiment definition lives in
# configs/qat_attn_ffn.yaml; hardware settings are applied through a generated
# effective config (same pattern as kaggle/kernel.py).
#
# GPU choice: PBS hides all GPUs and does not pin them, so cluster/pick_gpu.sh
# unsets CUDA_VISIBLE_DEVICES and selects the least-busy A100 at job start.

set -uo pipefail

REPO="/home/jiit_992401210050/Desktop/ASR WaveTransformer/ASR_1bit"
cd "$REPO" || exit 1

# shellcheck disable=SC1091
source cluster/pick_gpu.sh
export ONEBIT_AUDIO_DECODER=soundfile
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HUB_DISABLE_PROGRESS_BARS=1

LOG="logs/qat_attn_ffn.log"
mkdir -p logs results checkpoints
: > "$LOG"
exec > >(tee -a "$LOG") 2>&1

echo "=== job $PBS_JOBID on $(hostname) at $(date -Is) ==="
nvidia-smi --query-gpu=index,name,memory.used,memory.total,utilization.gpu \
    --format=csv,noheader

PY=".venv/bin/python"
$PY - <<'PY'
import torch
assert torch.cuda.is_available(), "CUDA not available"
print("torch", torch.__version__, "cuda", torch.version.cuda,
      "device", torch.cuda.get_device_name(0),
      "count", torch.cuda.device_count())
PY
if [ $? -ne 0 ]; then echo "ABORT: CUDA preflight failed"; exit 3; fi

# --- Effective (hardware-specific) config -----------------------------------
EFFECTIVE="configs/cluster_effective_attn_ffn.yaml"
cat > "$EFFECTIVE" <<'YAML'
# GENERATED by cluster/qat_attn_ffn.pbs — do not edit or commit.
extends: qat_attn_ffn.yaml
qat:
  training:
    fp16: true
    bf16: false
    gradient_checkpointing: false
    save_strategy: "no"
    logging_steps: 10
YAML
echo "effective config:"; cat "$EFFECTIVE"

# --- Full QAT run ------------------------------------------------------------
$PY scripts/train_qat.py \
    --config "$EFFECTIVE" \
    --output results/qat_attn_ffn.json \
    --checkpoint-dir checkpoints/qat_attn_ffn
TRAIN_RC=$?
echo "train_qat.py exit code: $TRAIN_RC"

# The save/load diagnostic must not block the deploy artifact (the Kaggle
# history in planning.md §5 shows why). Proceed whenever a result exists.
if [ ! -s results/qat_attn_ffn.json ]; then
    echo "ABORT: no training result written"
    exit 4
fi

# --- Packed deploy artifact (Phase 16) --------------------------------------
$PY scripts/pack_qat_model.py \
    --config "$EFFECTIVE" \
    --checkpoint checkpoints/qat_attn_ffn \
    --output checkpoints/qat_attn_ffn_packed/model_packed.safetensors \
    --report results/qat_attn_ffn_size_report.json
PACK_RC=$?
echo "pack exit code: $PACK_RC"

echo "=== finished at $(date -Is) ==="
exit 0
