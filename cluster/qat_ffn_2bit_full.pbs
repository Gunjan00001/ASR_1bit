#!/bin/bash
#PBS -N qat_ffn_2bit_full
#PBS -q gpu
#PBS -l select=1:ncpus=1:ngpus=1:mem=64gb
#PBS -l walltime=04:00:00
#PBS -j oe
#
# Full 2-bit mixed-FFN QAT: the pilot (job 12923) measured 2.99% dev-128 WER
# at 1,131,062,436 B and passed packed reload. The 17 FP32 FFN exclusions,
# layer selection, data, seed, optimizer, and LR are inherited unchanged.
# 10,000 train.100 utterances, 1,875 steps, 256-utterance dev selection.
#
# If interrupted, rerun: a result is preserved; an incomplete run resumes.
set -uo pipefail
REPO="/home/jiit_992401210050/Desktop/ASR WaveTransformer/ASR_1bit"
cd "$REPO" || exit 1
# shellcheck disable=SC1091
source cluster/pick_gpu.sh
export ONEBIT_AUDIO_DECODER=soundfile
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HUB_DISABLE_PROGRESS_BARS=1
export HF_DATASETS_DISABLE_PROGRESS_BARS=1

LOG="logs/qat_ffn_2bit_full.log"
mkdir -p logs results checkpoints
: > "$LOG"
exec > >(tee -a "$LOG") 2>&1

echo "=== job $PBS_JOBID on $(hostname) at $(date -Is) ==="
echo "commit: $(git rev-parse HEAD)"
nvidia-smi --query-gpu=index,name,memory.used,memory.total --format=csv,noheader

PY=".venv/bin/python"
$PY - <<'PY'
import torch
assert torch.cuda.is_available(), "CUDA not available"
print("torch", torch.__version__, "cuda", torch.version.cuda,
      "device", torch.cuda.get_device_name(0), "count", torch.cuda.device_count())
PY
if [ $? -ne 0 ]; then echo "ABORT: CUDA preflight failed"; exit 3; fi

EFFECTIVE="configs/cluster_effective_qat_ffn_mixed_2bit_full.yaml"
cat > "$EFFECTIVE" <<'YAML'
# GENERATED by cluster/qat_ffn_2bit_full.pbs — do not edit or commit.
extends: qat_ffn_mixed_2bit.yaml
qat:
  training:
    fp16: true
    bf16: false
    gradient_checkpointing: false
    save_strategy: "steps"
    save_steps: 250
    save_total_limit: 1
    logging_steps: 10
    eval_every_steps: 500
    eval_utterances: 256
YAML
echo "effective config:"; cat "$EFFECTIVE"

RESULT="results/qat_ffn_mixed_2bit_full.json"
CKPT="checkpoints/qat_ffn_mixed_2bit_full"
PACKED="checkpoints/qat_ffn_mixed_2bit_full_packed/model_packed.safetensors"
SIZE="results/qat_ffn_mixed_2bit_full_size_report.json"
VERIFY="results/packed_verify_qat_ffn_mixed_2bit_full.json"

if [ -s "$RESULT" ]; then
  echo "result exists; preserving it"
else
  RESUME=""
  if [ -d "$CKPT" ] && compgen -G "$CKPT/checkpoint-*" >/dev/null; then
    RESUME="--resume auto"
  fi
  $PY scripts/train_qat.py \
    --config "$EFFECTIVE" --output "$RESULT" --checkpoint-dir "$CKPT" $RESUME
  echo "train exit: $?"
fi
if [ ! -s "$RESULT" ]; then echo "ABORT: no full result"; exit 4; fi

if [ ! -s "$PACKED" ] || [ ! -s "$SIZE" ]; then
  $PY scripts/pack_qat_model.py --config "$EFFECTIVE" --checkpoint "$CKPT" \
    --output "$PACKED" --report "$SIZE"
  echo "pack exit: $?"
fi
if [ ! -s "$VERIFY" ]; then
  ONEBIT_AUDIO_DECODER=soundfile $PY scripts/verify_packed_artifact.py \
    --config "$EFFECTIVE" --checkpoint "$CKPT" --artifact "$PACKED" \
    --n 2 --output "$VERIFY"
  echo "verify exit: $?"
fi
echo "=== finished at $(date -Is) ==="
