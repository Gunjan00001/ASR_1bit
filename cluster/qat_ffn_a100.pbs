#!/bin/bash
#PBS -N qat_ffn_a100
#PBS -q gpu
#PBS -l select=1:ncpus=1:ngpus=1:mem=64gb
#PBS -l walltime=05:00:00
#PBS -j oe
#
# Phase 15 — FFN-only 1-bit QAT on an A100.
#
# Completes the layer-sensitivity matrix with a QAT (not PTQ) FFN-only arm.
# Outputs are named *_a100 and do not overwrite any historical result.

set -uo pipefail

REPO="/home/jiit_992401210050/Desktop/ASR WaveTransformer/ASR_1bit"
cd "$REPO" || exit 1

# shellcheck disable=SC1091
source cluster/pick_gpu.sh
export ONEBIT_AUDIO_DECODER=soundfile
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HUB_DISABLE_PROGRESS_BARS=1
export HF_DATASETS_DISABLE_PROGRESS_BARS=1

LOG="logs/qat_ffn_a100.log"
mkdir -p logs results checkpoints
: > "$LOG"
exec > >(tee -a "$LOG") 2>&1

echo "=== job $PBS_JOBID on $(hostname) at $(date -Is) ==="
nvidia-smi --query-gpu=index,name,memory.used,memory.total,utilization.gpu \
    --format=csv,noheader

PY=".venv/bin/python"
$PY - <<'PY'
import torch
assert torch.cuda.is_available(), "CUDA not available"
print("torch", torch.__version__, "cuda", torch.version.cuda,
      "device", torch.cuda.get_device_name(0),
      "count", torch.cuda.device_count())
PY
if [ $? -ne 0 ]; then echo "ABORT: CUDA preflight failed"; exit 3; fi

EFFECTIVE="configs/cluster_effective_qat_ffn.yaml"
cat > "$EFFECTIVE" <<'YAML'
# GENERATED by cluster/qat_ffn_a100.pbs — do not edit or commit.
extends: qat_ffn.yaml
qat:
  training:
    fp16: true
    bf16: false
    gradient_checkpointing: false
    save_strategy: "no"
    logging_steps: 10
YAML
echo "effective config:"; cat "$EFFECTIVE"

$PY scripts/train_qat.py \
    --config "$EFFECTIVE" \
    --output results/qat_ffn_a100.json \
    --checkpoint-dir checkpoints/qat_ffn_a100
TRAIN_RC=$?
echo "train_qat.py exit code: $TRAIN_RC"
[ -s results/qat_ffn_a100.json ] || { echo "ABORT: no result"; exit 4; }

$PY scripts/pack_qat_model.py \
    --config "$EFFECTIVE" \
    --checkpoint checkpoints/qat_ffn_a100 \
    --output checkpoints/qat_ffn_a100_packed/model_packed.safetensors \
    --report results/qat_ffn_a100_size_report.json
echo "pack exit code: $?"
echo "=== finished at $(date -Is) ==="
