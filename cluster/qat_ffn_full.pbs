#!/bin/bash
#PBS -N qat_ffn_full
#PBS -q gpu
#PBS -l select=1:ncpus=1:ngpus=1:mem=64gb
#PBS -l walltime=04:00:00
#PBS -j oe
#
# Full controlled FFN experiment:
#   control = per-tensor FFN-only QAT
#   mixed   = 79 BitLinear + the fixed 17-layer FP32 exclusion list
#
# Both arms: 10,000 train.100 utterances, 3 epochs / 1,875 steps, seed 42,
# batch 4 x accum 4, lr 2e-5, fp16, full 256-utterance dev selection.
# Trainer checkpoints every 250 steps (resume), best-dev state persisted to
# dev_best.pt, final 1,875-step state evaluated by the callback.
#
# This script never edits the quantization policy or exclusion list. Results are
# unique *_full files and never overwrite the pilot or historical runs.
#
# Submit ONLY when scripts/check_cluster_resources.py reports ready:
#   .venv/bin/python scripts/check_cluster_resources.py
#   qsub cluster/qat_ffn_full.pbs
#
# If interrupted, rerun the same qsub command: an arm with a Trainer checkpoint
# resumes automatically; an arm with a result is skipped, preserving it.

set -uo pipefail
REPO="/home/jiit_992401210050/Desktop/ASR WaveTransformer/ASR_1bit"
cd "$REPO" || exit 1
# shellcheck disable=SC1091
source cluster/pick_gpu.sh
export ONEBIT_AUDIO_DECODER=soundfile
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HUB_DISABLE_PROGRESS_BARS=1
export HF_DATASETS_DISABLE_PROGRESS_BARS=1

LOG="logs/qat_ffn_full.log"
mkdir -p logs results checkpoints
: > "$LOG"
exec > >(tee -a "$LOG") 2>&1

echo "=== job $PBS_JOBID on $(hostname) at $(date -Is) ==="
echo "commit: $(git rev-parse HEAD)"
nvidia-smi --query-gpu=index,name,memory.used,memory.total,utilization.gpu \
    --format=csv,noheader

PY=".venv/bin/python"
$PY - <<'PY'
import torch
assert torch.cuda.is_available(), "CUDA not available"
print("torch", torch.__version__, "cuda", torch.version.cuda,
      "device", torch.cuda.get_device_name(0), "count", torch.cuda.device_count())
PY
if [ $? -ne 0 ]; then echo "ABORT: CUDA preflight failed"; exit 3; fi

write_effective() {
  local base="$1" out="$2"
  cat > "$out" <<YAML
# GENERATED by cluster/qat_ffn_full.pbs — do not edit or commit.
extends: ${base}
qat:
  training:
    fp16: true
    bf16: false
    gradient_checkpointing: false
    save_strategy: "steps"
    save_steps: 250
    save_total_limit: 1
    logging_steps: 10
    eval_every_steps: 500
    eval_utterances: 256
YAML
}

CONTROL_CFG="configs/cluster_effective_qat_ffn_control_full.yaml"
MIXED_CFG="configs/cluster_effective_qat_ffn_mixed_full.yaml"
write_effective qat_ffn.yaml "$CONTROL_CFG"
write_effective qat_ffn_mixed.yaml "$MIXED_CFG"
echo "control config:"; cat "$CONTROL_CFG"
echo "mixed config:"; cat "$MIXED_CFG"

run_arm() {
  local label="$1" cfg="$2" arm="$3"
  local result="results/${arm}.json"
  local ckpt="checkpoints/${arm}"
  local packed="checkpoints/${arm}_packed/model_packed.safetensors"
  echo "=== ARM ${label} (${arm}) at $(date -Is) ==="

  if [ -s "$result" ]; then
    echo "result already exists; preserving it and skipping training"
  else
    local resume=""
    if [ -d "$ckpt" ] && compgen -G "$ckpt/checkpoint-*" >/dev/null; then
      resume="--resume auto"
    fi
    echo "training command: --config $cfg --output $result --checkpoint-dir $ckpt $resume"
    $PY scripts/train_qat.py \
      --config "$cfg" \
      --output "$result" \
      --checkpoint-dir "$ckpt" \
      $resume
    echo "train_qat exit: $?"
  fi

  if [ ! -s "$result" ]; then
    echo "ERROR: no result JSON for ${arm}; not packing"
    return 4
  fi

  if [ ! -s "$packed" ] || [ ! -s "results/${arm}_size_report.json" ]; then
    $PY scripts/pack_qat_model.py \
      --config "$cfg" \
      --checkpoint "$ckpt" \
      --output "$packed" \
      --report "results/${arm}_size_report.json"
    echo "pack exit: $?"
  else
    echo "packed artifact and size report exist; preserving them"
  fi

  local verify="results/packed_verify_${arm}.json"
  if [ ! -s "$verify" ]; then
    ONEBIT_AUDIO_DECODER=soundfile $PY scripts/verify_packed_artifact.py \
      --config "$cfg" \
      --checkpoint "$ckpt" \
      --artifact "$packed" \
      --n 2 \
      --output "$verify"
    echo "verify exit: $?"
  else
    echo "packed verification exists; preserving it"
  fi
  echo "=== ARM ${label} done at $(date -Is) ==="
  return 0
}

run_arm control "$CONTROL_CFG" qat_ffn_control_full
RC_CONTROL=$?
run_arm mixed "$MIXED_CFG" qat_ffn_mixed_full
RC_MIXED=$?

echo "control rc=$RC_CONTROL mixed rc=$RC_MIXED"
echo "=== finished at $(date -Is) ==="
if [ "$RC_CONTROL" -ne 0 ] || [ "$RC_MIXED" -ne 0 ]; then
  exit 1
fi
exit 0
