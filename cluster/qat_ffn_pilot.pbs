#!/bin/bash
#PBS -N qat_ffn_pilot
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=64gb
#PBS -l walltime=02:30:00
#PBS -j oe
#
# Controlled FFN pilot: per-tensor FFN-only control vs the mixed-precision FFN
# configuration selected from results/layer_sensitivity_ffn.json.
#
# 2,000 train.100 utterances, 500 optimizer steps, batch 4 x accum 4,
# dev-eval every 250 steps on 128 fixed dev utterances, best-dev state restored.
# This is a pilot, not an accuracy claim; the full 10k run only follows if the
# mixed arm is not worse than the control on dev WER.

set -uo pipefail
REPO="/home/jiit_992401210050/Desktop/ASR WaveTransformer/ASR_1bit"
cd "$REPO" || exit 1
# shellcheck disable=SC1091
source cluster/pick_gpu.sh
export ONEBIT_AUDIO_DECODER=soundfile
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HUB_DISABLE_PROGRESS_BARS=1
export HF_DATASETS_DISABLE_PROGRESS_BARS=1

LOG="logs/qat_ffn_pilot.log"
mkdir -p logs results checkpoints
: > "$LOG"
exec > >(tee -a "$LOG") 2>&1

echo "=== job $PBS_JOBID on $(hostname) at $(date -Is) ==="
nvidia-smi --query-gpu=index,name,memory.used,memory.total,utilization.gpu \
    --format=csv,noheader
PY=".venv/bin/python"
$PY - <<'PY'
import torch
assert torch.cuda.is_available(), "CUDA not available"
print("torch", torch.__version__, "cuda", torch.version.cuda,
      "device", torch.cuda.get_device_name(0), "count", torch.cuda.device_count())
PY
if [ $? -ne 0 ]; then echo "ABORT: CUDA preflight failed"; exit 3; fi

write_effective() {
  local base="$1" out="$2"
  cat > "$out" <<YAML
# GENERATED by cluster/qat_ffn_pilot.pbs — do not edit or commit.
extends: ${base}
qat:
  training:
    fp16: true
    bf16: false
    gradient_checkpointing: false
    save_strategy: "no"
    logging_steps: 10
YAML
}

CONTROL_CFG="configs/cluster_effective_ffn_control_pilot.yaml"
MIXED_CFG="configs/cluster_effective_ffn_mixed_pilot.yaml"
write_effective qat_ffn.yaml "$CONTROL_CFG"
write_effective qat_ffn_mixed.yaml "$MIXED_CFG"
echo "control effective config:"; cat "$CONTROL_CFG"
echo "mixed effective config:"; cat "$MIXED_CFG"

echo "=== PILOT 1/2: FFN-only per-tensor control ==="
$PY scripts/train_qat.py --config "$CONTROL_CFG" --pilot \
    --output results/qat_ffn_control_pilot.json \
    --checkpoint-dir checkpoints/qat_ffn_control_pilot
echo "control pilot exit: $?"

echo "=== PILOT 2/2: mixed-precision FFN (17 sensitive layers FP32) ==="
$PY scripts/train_qat.py --config "$MIXED_CFG" --pilot \
    --output results/qat_ffn_mixed_pilot.json \
    --checkpoint-dir checkpoints/qat_ffn_mixed_pilot
echo "mixed pilot exit: $?"

echo "=== finished at $(date -Is) ==="
